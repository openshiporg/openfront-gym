  defaultCurrency           String                     @default("USD")
  timezone                  String                     @default("America/Los_Angeles")
  isMultiLocation           Boolean                    @default(true)
  users                     User[]                     @relation("User_organization")
  roles                     Role[]                     @relation("Role_organization")
  members                   Member[]                   @relation("Member_organization")
  instructors               Instructor[]               @relation("Instructor_organization")
  locations                 Location[]                 @relation("Location_organization")
  resources                 GymResource[]              @relation("GymResource_organization")
  trainerAvailability       TrainerAvailability[]      @relation("TrainerAvailability_organization")
  appointments              TrainerAppointment[]       @relation("TrainerAppointment_organization")
  membershipTiers           MembershipTier[]           @relation("MembershipTier_organization")
  memberships               Membership[]               @relation("Membership_organization")
  membershipPayments        MembershipPayment[]        @relation("MembershipPayment_organization")
  subscriptions             Subscription[]             @relation("Subscription_organization")
  gymPayments               GymPayment[]               @relation("GymPayment_organization")
  paymentMethods            PaymentMethod[]            @relation("PaymentMethod_organization")
  paymentProviders          PaymentProvider[]          @relation("PaymentProvider_organization")
  paymentSessions           PaymentSession[]           @relation("PaymentSession_organization")
  paymentEvents             PaymentEvent[]             @relation("PaymentEvent_organization")
  checkIns                  CheckIn[]                  @relation("CheckIn_organization")
  workoutLogs               WorkoutLog[]               @relation("WorkoutLog_organization")
  workoutSets               WorkoutSet[]               @relation("WorkoutSet_organization")
  exercises                 Exercise[]                 @relation("Exercise_organization")
  waitlists                 Waitlist[]                 @relation("Waitlist_organization")
  attendanceRecords         AttendanceRecord[]         @relation("AttendanceRecord_organization")
  classTypes                ClassType[]                @relation("ClassType_organization")
  classSchedules            ClassSchedule[]            @relation("ClassSchedule_organization")
  classBookings             ClassBooking[]             @relation("ClassBooking_organization")
  classInstances            ClassInstance[]            @relation("ClassInstance_organization")
  gymSettings               GymSettings[]              @relation("GymSettings_organization")
  onboardingRuns            OnboardingRun[]            @relation("OnboardingRun_organization")
  refundAttempts            GymRefundAttempt[]         @relation("GymRefundAttempt_organization")
  membershipBillingAttempts MembershipBillingAttempt[] @relation("MembershipBillingAttempt_organization")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
}

model User {
  id                                 String              @id @default(cuid())
  organization                       Organization?       @relation("User_organization", fields: [organizationId], references: [id])
  organizationId                     String?             @map("organization")
  name                               String              @default("")
