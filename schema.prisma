  location           Location?      @relation("ClassInstance_location", fields: [locationId], references: [id])
  locationId         String?        @map("location")
  resource           GymResource?   @relation("ClassInstance_resource", fields: [resourceId], references: [id])
  resourceId         String?        @map("resource")
  endsAt             DateTime?
  changeHistory      Json?          @default("[]")
  occurrenceKey      String?        @unique
  classSchedule      ClassSchedule? @relation("ClassInstance_classSchedule", fields: [classScheduleId], references: [id])
  classScheduleId    String?        @map("classSchedule")
  date               DateTime
  instructor         Instructor?    @relation("ClassInstance_instructor", fields: [instructorId], references: [id])
  instructorId       String?        @map("instructor")
  maxCapacity        Int?
  isCancelled        Boolean        @default(false)
  cancellationReason String         @default("")
  bookings           ClassBooking[] @relation("ClassBooking_classInstance")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@unique([organizationId, classScheduleId, date])
  @@index([organizationId])
  @@index([locationId])
  @@index([resourceId])
  @@index([classScheduleId])
  @@index([instructorId])
}

model GymResource {
  id                          String               @id @default(cuid())
  organization                Organization         @relation("GymResource_organization", fields: [organizationId], references: [id])
  organizationId              String               @map("organization")
  location                    Location             @relation("GymResource_location", fields: [locationId], references: [id])
  locationId                  String               @map("location")
  name                        String               @default("")
  type                        GymResourceTypeType  @default(room)
  capacity                    Int?                 @default(1)
  isExclusive                 Boolean              @default(true)
  isActive                    Boolean              @default(true)
  setupBufferMinutes          Int?                 @default(0)
  cleanupBufferMinutes        Int?                 @default(0)
  notes                       String               @default("")
  metadata                    Json?                @default("{}")
  appointments                TrainerAppointment[] @relation("TrainerAppointment_resource")
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @default(now()) @updatedAt
  from_ClassSchedule_resource ClassSchedule[]      @relation("ClassSchedule_resource")
  from_ClassInstance_resource ClassInstance[]      @relation("ClassInstance_resource")

  @@index([organizationId])
  @@index([locationId])
}

model TrainerAvailability {
  id             String                      @id @default(cuid())
  organization   Organization                @relation("TrainerAvailability_organization", fields: [organizationId], references: [id])
  organizationId String                      @map("organization")
  instructor     Instructor                  @relation("TrainerAvailability_instructor", fields: [instructorId], references: [id])
  instructorId   String                      @map("instructor")
  location       Location                    @relation("TrainerAvailability_location", fields: [locationId], references: [id])
  locationId     String                      @map("location")
  type           TrainerAvailabilityTypeType @default(recurring)
  dayOfWeek      Int?
  date           DateTime?
  startTime      String                      @default("")
  endTime        String                      @default("")
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isAvailable    Boolean                     @default(true)
  reason         String                      @default("")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @default(now()) @updatedAt

  @@index([organizationId])
  @@index([instructorId])
  @@index([locationId])
}

model TrainerAppointment {
  id                                          String                       @id @default(cuid())
  organization                                Organization                 @relation("TrainerAppointment_organization", fields: [organizationId], references: [id])
  organizationId                              String                       @map("organization")
  member                                      Member                       @relation("TrainerAppointment_member", fields: [memberId], references: [id])
  memberId                                    String                       @map("member")
  instructor                                  Instructor                   @relation("TrainerAppointment_instructor", fields: [instructorId], references: [id])
  instructorId                                String                       @map("instructor")
  location                                    Location                     @relation("TrainerAppointment_location", fields: [locationId], references: [id])
  locationId                                  String                       @map("location")
  resource                                    GymResource?                 @relation("TrainerAppointment_resource", fields: [resourceId], references: [id])
  resourceId                                  String?                      @map("resource")
  startTime                                   DateTime
  endTime                                     DateTime
  durationMinutes                             Int
  status                                      TrainerAppointmentStatusType @default(scheduled)
  serviceName                                 String                       @default("")
  priceAmount                                 Int?                         @default(0)
  currencyCode                                String                       @default("USD")
  idempotencyKey                              String                       @default("")
  requestHash                                 String                       @default("")
  memberNotes                                 String                       @default("")
  internalNotes                               String                       @default("")
  cancellationReason                          String                       @default("")
  cancelledAt                                 DateTime?
  checkedInAt                                 DateTime?
  completedAt                                 DateTime?
  payment                                     GymPayment?                  @relation("TrainerAppointment_payment", fields: [paymentId], references: [id])
  paymentId                                   String?                      @map("payment")
  trainingPackage                             TrainingPackage?             @relation("TrainerAppointment_trainingPackage", fields: [trainingPackageId], references: [id])
  trainingPackageId                           String?                      @map("trainingPackage")
  replacesAppointment                         TrainerAppointment?          @relation("TrainerAppointment_replacesAppointment", fields: [replacesAppointmentId], references: [id])
  replacesAppointmentId                       String?                      @map("replacesAppointment")
  resourceStartsAt                            DateTime?
  resourceEndsAt                              DateTime?
  createdAt                                   DateTime                     @default(now())
  updatedAt                                   DateTime                     @default(now()) @updatedAt
  from_TrainingCreditEntry_appointment        TrainingCreditEntry[]        @relation("TrainingCreditEntry_appointment")
  from_TrainerAppointment_replacesAppointment TrainerAppointment[]         @relation("TrainerAppointment_replacesAppointment")

  @@unique([organizationId, idempotencyKey], map: "TrainerAppointment_organization_idempotency_key")
  @@index([organizationId])
  @@index([memberId])
  @@index([instructorId])
  @@index([locationId])
  @@index([resourceId])
  @@index([idempotencyKey])
  @@index([paymentId])
  @@index([trainingPackageId])
  @@index([replacesAppointmentId])
}

model OnboardingRun {
  id             String       @id @default(cuid())
  organization   Organization @relation("OnboardingRun_organization", fields: [organizationId], references: [id])
  organizationId String       @map("organization")
  status         String       @default("running")
  attempts       Int?         @default(0)
  lastError      String       @default("")
  startedAt      DateTime?
  completedAt    DateTime?
  leaseUntil     DateTime?
  leaseToken     String       @default("")

  @@unique([organizationId], map: "OnboardingRun_organization_key")
  @@index([organizationId])
}

model GymRefundAttempt {
  id                   String       @id @default(cuid())
  organization         Organization @relation("GymRefundAttempt_organization", fields: [organizationId], references: [id])
  organizationId       String       @map("organization")
  payment              GymPayment   @relation("GymRefundAttempt_payment", fields: [paymentId], references: [id])
  paymentId            String       @map("payment")
  requestKey           String       @default("")
  claimToken           String       @default("")
  amount               Int
  startingRefundAmount Int          @default(0)
  status               String?      @default("processing")
  providerRefundId     String       @default("")
  lastError            String       @default("")
  requestedAt          DateTime?
  completedAt          DateTime?

  @@unique([organizationId, requestKey], map: "GymRefundAttempt_organization_request_key")
  @@index([organizationId])
  @@index([paymentId])
}

model MembershipBillingAttempt {
  id             String       @id @default(cuid())
  organization   Organization @relation("MembershipBillingAttempt_organization", fields: [organizationId], references: [id])
  organizationId String       @map("organization")
  membership     Membership   @relation("MembershipBillingAttempt_membership", fields: [membershipId], references: [id])
  membershipId   String       @map("membership")
  operation      String
  idempotencyKey String       @default("")
  requestHash    String       @default("")
  claimToken     String       @default("")
  generation     Int          @default(0)
  status         String       @default("processing")
  leaseUntil     DateTime?
  lastError      String       @default("")
  requestedAt    DateTime     @default(now())
  completedAt    DateTime?

  @@unique([organizationId, membershipId, operation, idempotencyKey], map: "MembershipBillingAttempt_scope_operation_key")
  @@index([organizationId])
  @@index([membershipId])
  @@index([membershipId, status, leaseUntil], map: "MembershipBillingAttempt_membership_status_lease")
}

model AuthRateLimitBucket {
  id      String    @id @default(cuid())
  key     String
  count   Int       @default(0)
  resetAt DateTime?

  @@unique([key], map: "AuthRateLimitBucket_key")
}

enum OrganizationStatusType {
  active
  suspended
}

enum GymResourceTypeType {
  room
  court
  lane
  equipment
  recovery
  other
}

enum TrainerAvailabilityTypeType {
  recurring
  one_time
  time_off
}

enum TrainerAppointmentStatusType {
  scheduled
  confirmed
  checked_in
  completed
  cancelled
  no_show
}
