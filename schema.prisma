  booking         ClassBooking?  @relation("AttendanceRecord_booking", fields: [bookingId], references: [id])
  bookingId       String?        @map("booking")
  classSchedule   ClassSchedule? @relation("AttendanceRecord_classSchedule", fields: [classScheduleId], references: [id])
  classScheduleId String?        @map("classSchedule")
  member          Member?        @relation("AttendanceRecord_member", fields: [memberId], references: [id])
  memberId        String?        @map("member")
  attended        Boolean        @default(false)
  markedAt        DateTime?
  markedBy        User?          @relation("AttendanceRecord_markedBy", fields: [markedById], references: [id])
  markedById      String?        @map("markedBy")
  noShowReason    String         @default("")
  lateArrival     Boolean        @default(false)
  minutesLate     Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@unique([organizationId, bookingId])
  @@index([organizationId])
  @@index([bookingId])
  @@index([classScheduleId])
  @@index([memberId])
  @@index([markedById])
}

model ClassType {
  id              String          @id @default(cuid())
  organization    Organization    @relation("ClassType_organization", fields: [organizationId], references: [id])
  organizationId  String          @map("organization")
  name            String          @default("")
  description     Json            @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  difficulty      String          @default("all-levels")
  duration        Int             @default(60)
  equipmentNeeded Json            @default("[]")
  caloriesBurn    Int?
  schedules       ClassSchedule[] @relation("ClassSchedule_classType")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClassSchedule {
  id                                  String             @id @default(cuid())
  organization                        Organization       @relation("ClassSchedule_organization", fields: [organizationId], references: [id])
  organizationId                      String             @map("organization")
  name                                String             @default("")
  description                         String             @default("")
  instructor                          Instructor?        @relation("ClassSchedule_instructor", fields: [instructorId], references: [id])
  instructorId                        String?            @map("instructor")
  classType                           ClassType?         @relation("ClassSchedule_classType", fields: [classTypeId], references: [id])
  classTypeId                         String?            @map("classType")
  dayOfWeek                           String
  startTime                           String             @default("")
  endTime                             String             @default("")
  maxCapacity                         Int                @default(20)
  isActive                            Boolean            @default(true)
  instances                           ClassInstance[]    @relation("ClassInstance_classSchedule")
  createdAt                           DateTime           @default(now())
  updatedAt                           DateTime           @default(now()) @updatedAt
  from_Waitlist_classSchedule         Waitlist[]         @relation("Waitlist_classSchedule")
  from_AttendanceRecord_classSchedule AttendanceRecord[] @relation("AttendanceRecord_classSchedule")

  @@unique([organizationId, name, dayOfWeek, startTime, instructorId])
  @@index([organizationId])
  @@index([instructorId])
  @@index([classTypeId])
}

model ClassBooking {
  id                            String             @id @default(cuid())
  organization                  Organization       @relation("ClassBooking_organization", fields: [organizationId], references: [id])
  organizationId                String             @map("organization")
  classInstance                 ClassInstance?     @relation("ClassBooking_classInstance", fields: [classInstanceId], references: [id])
  classInstanceId               String?            @map("classInstance")
  member                        Member?            @relation("ClassBooking_member", fields: [memberId], references: [id])
  memberId                      String?            @map("member")
  memberName                    String             @default("")
  memberEmail                   String             @default("")
  memberPhone                   String             @default("")
  notes                         String             @default("")
  activeBookingKey              String?
  status                        String             @default("confirmed")
  waitlistPosition              Int?
  bookedAt                      DateTime           @default(now())
  cancelledAt                   DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @default(now()) @updatedAt
  from_AttendanceRecord_booking AttendanceRecord[] @relation("AttendanceRecord_booking")

  @@unique([organizationId, classInstanceId, memberId, activeBookingKey])
  @@index([organizationId])
  @@index([classInstanceId])
  @@index([memberId])
}

model Instructor {
  id             String                @id @default(cuid())
  organization   Organization          @relation("Instructor_organization", fields: [organizationId], references: [id])
  organizationId String                @map("organization")
  user           User?                 @relation("Instructor_user", fields: [userId], references: [id])
  userId         String?               @map("user")
  bio            Json                  @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  specialties    Json?                 @default("[]")
  certifications Json?                 @default("[]")
  photo          String                @default("")
  isActive       Boolean               @default(true)
  classSchedules ClassSchedule[]       @relation("ClassSchedule_instructor")
  classInstances ClassInstance[]       @relation("ClassInstance_instructor")
  availability   TrainerAvailability[] @relation("TrainerAvailability_instructor")
  appointments   TrainerAppointment[]  @relation("TrainerAppointment_instructor")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model ClassInstance {
  id                 String         @id @default(cuid())
  organization       Organization   @relation("ClassInstance_organization", fields: [organizationId], references: [id])
  organizationId     String         @map("organization")
  classSchedule      ClassSchedule? @relation("ClassInstance_classSchedule", fields: [classScheduleId], references: [id])
  classScheduleId    String?        @map("classSchedule")
  date               DateTime
  instructor         Instructor?    @relation("ClassInstance_instructor", fields: [instructorId], references: [id])
  instructorId       String?        @map("instructor")
  maxCapacity        Int?
  isCancelled        Boolean        @default(false)
  cancellationReason String         @default("")
  bookings           ClassBooking[] @relation("ClassBooking_classInstance")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@unique([organizationId, classScheduleId, date])
  @@index([organizationId])
  @@index([classScheduleId])
  @@index([instructorId])
}

model GymResource {
  id                   String               @id @default(cuid())
  organization         Organization         @relation("GymResource_organization", fields: [organizationId], references: [id])
  organizationId       String               @map("organization")
  location             Location             @relation("GymResource_location", fields: [locationId], references: [id])
  locationId           String               @map("location")
  name                 String               @default("")
  type                 GymResourceTypeType  @default(room)
  capacity             Int?                 @default(1)
  isExclusive          Boolean              @default(true)
  isActive             Boolean              @default(true)
  setupBufferMinutes   Int?                 @default(0)
  cleanupBufferMinutes Int?                 @default(0)
  notes                String               @default("")
  metadata             Json?                @default("{}")
  appointments         TrainerAppointment[] @relation("TrainerAppointment_resource")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt

  @@index([organizationId])
  @@index([locationId])
}

model TrainerAvailability {
  id             String                      @id @default(cuid())
  organization   Organization                @relation("TrainerAvailability_organization", fields: [organizationId], references: [id])
  organizationId String                      @map("organization")
  instructor     Instructor                  @relation("TrainerAvailability_instructor", fields: [instructorId], references: [id])
  instructorId   String                      @map("instructor")
  location       Location                    @relation("TrainerAvailability_location", fields: [locationId], references: [id])
  locationId     String                      @map("location")
  type           TrainerAvailabilityTypeType @default(recurring)
  dayOfWeek      Int?
  date           DateTime?
  startTime      String                      @default("")
  endTime        String                      @default("")
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isAvailable    Boolean                     @default(true)
  reason         String                      @default("")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @default(now()) @updatedAt

  @@index([organizationId])
  @@index([instructorId])
  @@index([locationId])
}

model TrainerAppointment {
  id                 String                       @id @default(cuid())
  organization       Organization                 @relation("TrainerAppointment_organization", fields: [organizationId], references: [id])
  organizationId     String                       @map("organization")
  member             Member                       @relation("TrainerAppointment_member", fields: [memberId], references: [id])
  memberId           String                       @map("member")
  instructor         Instructor                   @relation("TrainerAppointment_instructor", fields: [instructorId], references: [id])
  instructorId       String                       @map("instructor")
  location           Location                     @relation("TrainerAppointment_location", fields: [locationId], references: [id])
  locationId         String                       @map("location")
  resource           GymResource?                 @relation("TrainerAppointment_resource", fields: [resourceId], references: [id])
  resourceId         String?                      @map("resource")
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  status             TrainerAppointmentStatusType @default(scheduled)
  serviceName        String                       @default("")
  priceAmount        Int?                         @default(0)
  currencyCode       String                       @default("USD")
  idempotencyKey     String                       @default("")
  requestHash        String                       @default("")
  memberNotes        String                       @default("")
  internalNotes      String                       @default("")
  cancellationReason String                       @default("")
  cancelledAt        DateTime?
  checkedInAt        DateTime?
  completedAt        DateTime?
  payment            GymPayment?                  @relation("TrainerAppointment_payment", fields: [paymentId], references: [id])
  paymentId          String?                      @map("payment")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @default(now()) @updatedAt

  @@unique([organizationId, idempotencyKey], map: "TrainerAppointment_organization_idempotency_key")
  @@index([organizationId])
  @@index([memberId])
  @@index([instructorId])
  @@index([locationId])
  @@index([resourceId])
  @@index([idempotencyKey])
  @@index([paymentId])
}

model OnboardingRun {
  id             String       @id @default(cuid())
  organization   Organization @relation("OnboardingRun_organization", fields: [organizationId], references: [id])
  organizationId String       @map("organization")
  status         String       @default("running")
  attempts       Int?         @default(0)
  lastError      String       @default("")
  startedAt      DateTime?
  completedAt    DateTime?
  leaseUntil     DateTime?
  leaseToken     String       @default("")

  @@unique([organizationId], map: "OnboardingRun_organization_key")
  @@index([organizationId])
}

model GymRefundAttempt {
  id                   String       @id @default(cuid())
  organization         Organization @relation("GymRefundAttempt_organization", fields: [organizationId], references: [id])
  organizationId       String       @map("organization")
  payment              GymPayment   @relation("GymRefundAttempt_payment", fields: [paymentId], references: [id])
  paymentId            String       @map("payment")
  requestKey           String       @default("")
  claimToken           String       @default("")
  amount               Int
  startingRefundAmount Int          @default(0)
  status               String?      @default("processing")
  providerRefundId     String       @default("")
  lastError            String       @default("")
  requestedAt          DateTime?
  completedAt          DateTime?

  @@unique([organizationId, requestKey], map: "GymRefundAttempt_organization_request_key")
  @@index([organizationId])
  @@index([paymentId])
}

model MembershipBillingAttempt {
  id             String       @id @default(cuid())
  organization   Organization @relation("MembershipBillingAttempt_organization", fields: [organizationId], references: [id])
  organizationId String       @map("organization")
  membership     Membership   @relation("MembershipBillingAttempt_membership", fields: [membershipId], references: [id])
  membershipId   String       @map("membership")
  operation      String
  idempotencyKey String       @default("")
  requestHash    String       @default("")
  claimToken     String       @default("")
  generation     Int          @default(0)
  status         String       @default("processing")
  leaseUntil     DateTime?
  lastError      String       @default("")
  requestedAt    DateTime     @default(now())
  completedAt    DateTime?

  @@unique([organizationId, membershipId, operation, idempotencyKey], map: "MembershipBillingAttempt_scope_operation_key")
  @@index([organizationId])
  @@index([membershipId])
  @@index([membershipId, status, leaseUntil], map: "MembershipBillingAttempt_membership_status_lease")
}

model AuthRateLimitBucket {
  id      String    @id @default(cuid())
  key     String
  count   Int       @default(0)
  resetAt DateTime?

  @@unique([key], map: "AuthRateLimitBucket_key")
}

enum OrganizationStatusType {
  active
  suspended
}

enum GymResourceTypeType {
  room
  court
  lane
  equipment
  recovery
  other
}

enum TrainerAvailabilityTypeType {
  recurring
  one_time
  time_off
}

enum TrainerAppointmentStatusType {
  scheduled
  confirmed
  checked_in
  completed
  cancelled
  no_show
}
