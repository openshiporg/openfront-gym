# Openfront Gym environment contract
# Copy to .env and replace every value needed by the flows you enable.
# Never commit real credentials.

# Core runtime (required in strict/production mode). DATABASE_URL must be PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openfront_gym_dev
SESSION_SECRET=replace-with-at-least-32-random-characters
# Abuse budgets use the client's address. Set to true only when the deployment's proxy appends the
# connecting address to X-Forwarded-For (confirm for your host); otherwise forwarded headers are ignored.
CLIENT_SOURCE_TRUST_PROXY=false
# Public browser origin: payment success/cancel/portal returns and email links use it.
NEXTAUTH_URL=http://localhost:3000
# Optional private origin for credential-bearing server-to-server GraphQL calls (never sent to browsers).
# INTERNAL_APP_URL takes precedence; INTERNAL_GRAPHQL_URL is accepted for the same purpose.
# INTERNAL_APP_URL=http://127.0.0.1:3000
INTERNAL_GRAPHQL_URL=http://127.0.0.1:3000

# Public storefront tenant binding.
# Optional only when the database has exactly one active Organization and public member signup is disabled.
# Required for multiple Organizations and whenever PUBLIC_MEMBER_SIGNUPS_ALLOWED=true.
# STOREFRONT_ORGANIZATION_ID=gym_organization_id

# Object storage (required in strict/production mode)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (password reset and setup links, staff copies of contact messages).
# Off unless explicitly true; when false no email is sent from any entry point.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STORE_LINK=http://localhost:3000
CONTACT_FORM_TO=

# Public dashboard User signup is unsupported for Gym without a tenant-bound operator onboarding flow.
# Keep the canonical Openfront flag false; dashboard signup requests are refused either way.
PUBLIC_SIGNUPS_ALLOWED=false

# Public member signup is separate, fail-closed, and tenant-bound to the storefront.
# When enabled, the member signup organization must exactly match STOREFRONT_ORGANIZATION_ID.
PUBLIC_MEMBER_SIGNUPS_ALLOWED=false
# PUBLIC_MEMBER_SIGNUP_ORGANIZATION_ID=gym_organization_id

# Stripe (memberships and counter card payments). STRIPE_ENABLED=true admits NEW charges;
# with it false, existing subscriptions, refunds and signed webhooks still reconcile while the
# credentials below remain. Checkout requires exactly one installed Stripe merchant
# organization; connected-account (per-tenant) charging is not supported.
STRIPE_ENABLED=false
# Set to true only when the provider record comes from this environment instead of the database.
# STRIPE_USE_ENVIRONMENT_PROVIDER=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook account routing only; account-scoped charging is not supported.
# STRIPE_ACCOUNT_ID=acct_...
# Never enable in production. Used only by isolated payment tests.
PAYMENT_TEST_MODE=false
# PAYMENT_TEST_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Rotating member QR codes
QR_CODE_SECRET=replace-with-at-least-32-random-characters

# Staff-unlocked kiosk. Both values are required for /kiosk/check-in.
# The browser exchanges this credential for a 12-hour HttpOnly kiosk session.
KIOSK_API_TOKEN=replace-with-at-least-32-random-characters
KIOSK_ORGANIZATION_ID=gym_organization_id

# Partner discovery is fail-closed unless every enabled boundary is configured.
# DISCOVERY_API_KEY=replace-with-at-least-32-random-characters
# DISCOVERY_ORGANIZATION_ID=gym_organization_id
# DISCOVERY_API_SCOPES=classes:read,bookings:create
# DISCOVERY_PARTNER_ALLOWLIST=partner-example

# Optional AI completion route
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_MAX_TOKENS=1024
